{
  "name": "display-room",
  "private": true,
  "workspaces": [
    "server"
  ],
  "scripts": {
    "start": "npm --workspace server start",
    "dev": "npm --workspace server run dev",
    "prepare-client-vendor": "mkdir -p client/public/vendor && cp node_modules/mediasoup-client/dist/mediasoup-client.min.js client/public/vendor/mediasoup-client.min.js",
    "postinstall": "npm run prepare-client-vendor"
  },
  "dependencies": {
    "mediasoup-client": "^3.15.5"
  }
}
